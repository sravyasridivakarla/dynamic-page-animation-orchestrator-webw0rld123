{
  "openapi": "3.0.0",
  "info": {
    "title": "Page Config Drafter API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ],
  "paths": {
    "/v1/page-config/draft": {
      "post": {
        "summary": "Generate a page config draft from Knowledge Graph context",
        "operationId": "generate_draft",
        "tags": ["page-config"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftGenerateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Draft created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageConfigResponse"
                }
              }
            }
          },
          "503": {
            "description": "KG Service or Provenance Store unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/page-config/draft/{draft_id}/diff": {
      "get": {
        "summary": "Retrieve structured diff for approval surface",
        "operationId": "get_draft_diff",
        "tags": ["page-config"],
        "parameters": [
          {
            "name": "draft_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Structured diff with completeness warnings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftDiffResponse"
                }
              }
            }
          },
          "404": {
            "description": "Draft not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/page-config/draft/{draft_id}/approve": {
      "post": {
        "summary": "Submit approval signal; persists config",
        "operationId": "approve_draft",
        "tags": ["page-config"],
        "parameters": [
          {
            "name": "draft_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApproveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft approved and persisted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalResponse"
                }
              }
            }
          },
          "404": {
            "description": "Draft not found"
          },
          "503": {
            "description": "Provenance Store unavailable"
          }
        }
      }
    },
    "/v1/page-config/draft/{draft_id}/reject": {
      "post": {
        "summary": "Submit rejection signal; records in provenance",
        "operationId": "reject_draft",
        "tags": ["page-config"],
        "parameters": [
          {
            "name": "draft_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RejectRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft rejected and recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RejectionResponse"
                }
              }
            }
          },
          "404": {
            "description": "Draft not found"
          },
          "503": {
            "description": "Provenance Store unavailable"
          }
        }
      }
    },
    "/v1/page-config/{config_id}/rollback": {
      "post": {
        "summary": "Restore prior version from provenance trail",
        "operationId": "rollback_config",
        "tags": ["page-config"],
        "parameters": [
          {
            "name": "config_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RollbackRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Config rolled back to specified version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RollbackResponse"
                }
              }
            }
          },
          "404": {
            "description": "Config not found"
          },
          "503": {
            "description": "Provenance Store unavailable"
          }
        }
      }
    },
    "/v1/page-config/{config_id}/delete-proposal": {
      "post": {
        "summary": "Propose deletion; returns diff with unwind option",
        "operationId": "propose_deletion",
        "tags": ["page-config"],
        "parameters": [
          {
            "name": "config_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deletion proposal with unwind option",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteProposalResponse"
                }
              }
            }
          },
          "404": {
            "description": "Config not found"
          },
          "503": {
            "description": "Provenance Store unavailable"
          }
        }
      }
    },
    "/v1/page-config/{config_id}/delete-confirm": {
      "post": {
        "summary": "Execute confirmed deletion with explicit human confirmation",
        "operationId": "confirm_deletion",
        "tags": ["page-config"],
        "parameters": [
          {
            "name": "config_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteConfirmRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Config deleted; no automated compensation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteConfirmResponse"
                }
              }
            }
          },
          "422": {
            "description": "Explicit confirmation not provided"
          },
          "503": {
            "description": "Provenance Store unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DraftGenerateRequest": {
        "type": "object",
        "required": ["product_id"],
        "properties": {
          "product_id": {
            "type": "string"
          }
        }
      },
      "ApproveRequest": {
        "type": "object",
        "properties": {
          "justification": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "RejectRequest": {
        "type": "object",
        "required": ["reason"],
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      },
      "RollbackRequest": {
        "type": "object",
        "required": ["version"],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "DeleteConfirmRequest": {
        "type": "object",
        "required": ["explicit_confirm"],
        "properties": {
          "explicit_confirm": {
            "type": "boolean"
          }
        }
      },
      "ScrollSectionResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "page_config_id": { "type": "string", "format": "uuid" },
          "order": { "type": "integer" },
          "content": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "VisualRepresentationResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "page_config_id": { "type": "string", "format": "uuid" },
          "type": { "type": "string" },
          "url": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "SourcingTimelineEventResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "page_config_id": { "type": "string", "format": "uuid" },
          "event_type": { "type": "string" },
          "date": { "type": "string", "format": "date-time" },
          "validated": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "PageConfigResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "product_id": { "type": "string" },
          "workflow_state": { "type": "string" },
          "version": { "type": "integer" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "scroll_sections": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ScrollSectionResponse" }
          },
          "visual_representations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/VisualRepresentationResponse" }
          },
          "sourcing_timeline_events": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SourcingTimelineEventResponse" }
          }
        }
      },
      "DraftDiffResponse": {
        "type": "object",
        "properties": {
          "draft_id": { "type": "string", "format": "uuid" },
          "product_id": { "type": "string" },
          "diff": { "type": "object" },
          "completeness_warnings": {
            "type": "array",
            "items": { "type": "string" }
          },
          "has_incomplete_fields": { "type": "boolean" },
          "event_type_warnings": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "DeleteProposalResponse": {
        "type": "object",
        "properties": {
          "config_id": { "type": "string", "format": "uuid" },
          "diff": { "type": "object" },
          "unwind_option": { "type": "string" }
        }
      },
      "ApprovalResponse": {
        "type": "object",
        "properties": {
          "draft_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "RejectionResponse": {
        "type": "object",
        "properties": {
          "draft_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "RollbackResponse": {
        "type": "object",
        "properties": {
          "config_id": { "type": "string", "format": "uuid" },
          "restored_version": { "type": "integer" },
          "message": { "type": "string" }
        }
      },
      "DeleteConfirmResponse": {
        "type": "object",
        "properties": {
          "config_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string" },
          "message": { "type": "string" },
          "unwind_reminder": { "type": "string" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "detail": { "type": "string" }
        }
      }
    }
  }
}
