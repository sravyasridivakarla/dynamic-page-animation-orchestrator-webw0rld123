{
  "openapi": "3.0.0",
  "info": {
    "title": "Page Config Drafter API",
    "version": "1.0.0",
    "description": "Agent-driven page configuration drafting with human-in-the-loop approval"
  },
  "servers": [
    { "url": "http://localhost:8000" }
  ],
  "paths": {
    "/v1/page-configs/draft": {
      "post": {
        "summary": "Generate a create draft for a new page config",
        "operationId": "create_draft",
        "tags": ["page-config-drafter"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GenerateCreateDraftRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft generated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DiffResponse" }
              }
            }
          },
          "401": { "description": "Missing or invalid Authorization header" },
          "503": { "description": "Knowledge Graph Service unavailable" }
        }
      }
    },
    "/v1/page-configs/approve": {
      "post": {
        "summary": "Accept merchandiser approval and persist the draft",
        "operationId": "approve_draft",
        "tags": ["page-config-drafter"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "X-User-ID",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ApproveRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft approved and persisted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApproveResponse" }
              }
            }
          },
          "400": { "description": "Invalid draft state or parent not found" },
          "401": { "description": "Missing or invalid credentials" },
          "503": { "description": "Provenance Store unavailable" }
        }
      }
    },
    "/v1/page-configs/{config_id}": {
      "get": {
        "summary": "Retrieve the current state of a page config",
        "operationId": "get_config",
        "tags": ["page-config-drafter"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "config_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page config details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PageConfigDetailResponse" }
              }
            }
          },
          "401": { "description": "Missing or invalid Authorization header" },
          "404": { "description": "Page config not found" }
        }
      }
    },
    "/v1/page-configs/{config_id}/draft": {
      "post": {
        "summary": "Generate an update draft for an existing page config",
        "operationId": "update_draft",
        "tags": ["page-config-drafter"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "config_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GenerateUpdateDraftRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Update draft generated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DiffResponse" }
              }
            }
          },
          "401": { "description": "Missing or invalid Authorization header" },
          "404": { "description": "Page config not found" },
          "503": { "description": "Knowledge Graph Service unavailable" }
        }
      }
    },
    "/v1/page-configs/{config_id}/delete-draft": {
      "post": {
        "summary": "Generate a delete draft for an existing page config",
        "operationId": "delete_draft",
        "tags": ["page-config-drafter"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "config_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "type": "object" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Delete draft generated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DiffResponse" }
              }
            }
          },
          "401": { "description": "Missing or invalid Authorization header" },
          "404": { "description": "Page config not found" }
        }
      }
    },
    "/v1/page-configs/{config_id}/rollback": {
      "post": {
        "summary": "Restore a prior config version from the audit trail",
        "operationId": "rollback_config",
        "tags": ["page-config-drafter"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "config_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "X-User-ID",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RollbackRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Config rolled back to prior version",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RollbackResponse" }
              }
            }
          },
          "401": { "description": "Missing or invalid credentials" },
          "404": { "description": "Page config not found" },
          "503": { "description": "Provenance Store unavailable" }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Liveness health check",
        "operationId": "health_check",
        "tags": ["health"],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "service": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "GenerateCreateDraftRequest": {
        "type": "object",
        "required": ["product_id"],
        "properties": {
          "product_id": { "type": "string" }
        }
      },
      "GenerateUpdateDraftRequest": {
        "type": "object",
        "properties": {
          "product_id": { "type": "string", "nullable": true }
        }
      },
      "ApproveRequest": {
        "type": "object",
        "required": ["approval_token", "approved"],
        "properties": {
          "approval_token": { "type": "string" },
          "approved": { "type": "boolean" }
        }
      },
      "ApproveResponse": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "status": { "type": "string" }
        }
      },
      "RollbackRequest": {
        "type": "object",
        "required": ["to_version"],
        "properties": {
          "to_version": { "type": "string", "format": "uuid" }
        }
      },
      "RollbackResponse": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "status": { "type": "string" }
        }
      },
      "WorkflowState": {
        "type": "string",
        "enum": ["DRAFT_PENDING", "APPROVED", "PERSISTED"]
      },
      "DiffOperation": {
        "type": "string",
        "enum": ["CREATE", "UPDATE", "DELETE"]
      },
      "ScrollSectionDraft": {
        "type": "object",
        "required": ["position", "heading", "content"],
        "properties": {
          "id": { "type": "string", "format": "uuid", "nullable": true },
          "position": { "type": "integer" },
          "heading": { "type": "string" },
          "content": { "type": "string" },
          "background_image_url": { "type": "string" }
        }
      },
      "VisualRepresentationDraft": {
        "type": "object",
        "required": ["type", "url", "position"],
        "properties": {
          "id": { "type": "string", "format": "uuid", "nullable": true },
          "type": { "type": "string" },
          "url": { "type": "string" },
          "alt_text": { "type": "string" },
          "position": { "type": "integer" }
        }
      },
      "SourcingTimelineEventDraft": {
        "type": "object",
        "required": ["timestamp", "event_type"],
        "properties": {
          "id": { "type": "string", "format": "uuid", "nullable": true },
          "timestamp": { "type": "string", "format": "date-time" },
          "event_type": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "PageConfigDraft": {
        "type": "object",
        "required": ["product_id", "page_title", "meta_description", "layout_type", "visibility_status"],
        "properties": {
          "id": { "type": "string", "format": "uuid", "nullable": true },
          "product_id": { "type": "string" },
          "page_title": { "type": "string" },
          "meta_description": { "type": "string" },
          "layout_type": { "type": "string" },
          "visibility_status": { "type": "string" },
          "scroll_sections": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ScrollSectionDraft" }
          },
          "visual_representations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/VisualRepresentationDraft" }
          },
          "sourcing_timeline_events": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SourcingTimelineEventDraft" }
          },
          "workflow_state": { "$ref": "#/components/schemas/WorkflowState" },
          "validation_warnings": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "DiffChange": {
        "type": "object",
        "properties": {
          "before": {},
          "after": {}
        }
      },
      "KGSource": {
        "type": "object",
        "required": ["field", "source", "contribution"],
        "properties": {
          "field": { "type": "string" },
          "source": { "type": "string" },
          "contribution": { "type": "string" }
        }
      },
      "DiffResponse": {
        "type": "object",
        "required": ["operation", "draft", "approval_token"],
        "properties": {
          "operation": { "$ref": "#/components/schemas/DiffOperation" },
          "draft": { "$ref": "#/components/schemas/PageConfigDraft" },
          "prior_state": {
            "nullable": true,
            "allOf": [{ "$ref": "#/components/schemas/PageConfigDraft" }]
          },
          "changes": {
            "type": "object",
            "additionalProperties": { "$ref": "#/components/schemas/DiffChange" }
          },
          "kg_sources": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/KGSource" }
          },
          "reasoning_trace": { "type": "string" },
          "validation_warnings": {
            "type": "array",
            "items": { "type": "string" }
          },
          "approval_token": { "type": "string" }
        }
      },
      "ScrollSectionResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "config_id": { "type": "string", "format": "uuid" },
          "position": { "type": "integer" },
          "heading": { "type": "string" },
          "content": { "type": "string" },
          "background_image_url": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "VisualRepresentationResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "config_id": { "type": "string", "format": "uuid" },
          "type": { "type": "string" },
          "url": { "type": "string" },
          "alt_text": { "type": "string" },
          "position": { "type": "integer" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "SourcingTimelineEventResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "config_id": { "type": "string", "format": "uuid" },
          "timestamp": { "type": "string", "format": "date-time" },
          "event_type": { "type": "string" },
          "description": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "PageConfigDetailResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "product_id": { "type": "string" },
          "page_title": { "type": "string" },
          "meta_description": { "type": "string" },
          "layout_type": { "type": "string" },
          "visibility_status": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "created_by": { "type": "string" },
          "updated_by": { "type": "string" },
          "scroll_sections": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ScrollSectionResponse" }
          },
          "visual_representations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/VisualRepresentationResponse" }
          },
          "sourcing_timeline_events": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SourcingTimelineEventResponse" }
          }
        }
      }
    }
  }
}
